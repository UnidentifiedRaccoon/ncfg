# Server
HOST=0.0.0.0
PORT=1337

# Secrets (generate with: openssl rand -base64 32)
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Database
# Option 1: SQLite (for quick local development)
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# Option 2: PostgreSQL (recommended for development and production)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ncfg_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

# S3/Object Storage for uploads (required, S3-only mode)
AWS_BUCKET=ncfg-uploads-1770291983
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ru-central1
AWS_ENDPOINT=https://storage.yandexcloud.net

{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": {
    "singularName": "news-article",
    "pluralName": "news-articles",
    "displayName": "News Article",
    "description": "News and announcements"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "config": {
    "metadatas": {
      "anonsImage": {
        "edit": {
          "description": "Рекомендуемое соотношение сторон: 4:3 (например, 400x300)."
        },
        "list": {}
      },
      "postImage": {
        "edit": {
          "description": "Рекомендуемое соотношение сторон: 16:9 (например, 1920x1080)."
        },
        "list": {}
      }
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "showQuestionForm": {
      "type": "boolean",
      "default": true
    },
    "questionFormTitle": {
      "type": "string",
      "maxLength": 255
    },
    "questionFormDescription": {
      "type": "text"
    },
    "anonsImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "postImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::blog-category.blog-category",
      "inversedBy": "news_articles",
      "required": true
    },
    "publishedDate": {
      "type": "date"
    }
  }
}

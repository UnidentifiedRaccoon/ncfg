{
  "collectionName": "components_hr_diagnostic_questions",
  "info": {
    "displayName": "HR Diagnostic Question",
    "description": "Stable HR diagnostic question. Keep key values unchanged after launch.",
    "icon": "question"
  },
  "options": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "title": {
      "type": "text",
      "required": true
    },
    "subTitle": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "enum": ["radio", "checkbox", "likert", "email"],
      "required": true
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "allowOther": {
      "type": "boolean",
      "default": false
    },
    "maxSelections": {
      "type": "integer"
    },
    "showWhen": {
      "type": "json"
    },
    "options": {
      "type": "component",
      "repeatable": true,
      "component": "hr-diagnostic.option"
    }
  }
}

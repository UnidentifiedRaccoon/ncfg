# Strapi CMS Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# GetCourse integration
GETCOURSE_BASE_URL=https://fgrm.ncfg.ru
GETCOURSE_API_KEY=
GETCOURSE_LEAD_GROUP_NAME=Website Leads
GETCOURSE_QUESTION_GROUP_NAME=Website Questions
GETCOURSE_SOURCE_VALUE=fgrm.ncfg.ru

# Optional fallback recipient (used only when GetCourse is not configured)
LEADS_RECIPIENT_EMAIL=

# Optional UI variants
NEXT_PUBLIC_HEADER_VARIANT=dock
NEXT_PUBLIC_FOOTER_VARIANT=hero

# Optional: extra fields in GetCourse (must already exist in account)
GETCOURSE_FIELD_SOURCE=
GETCOURSE_FIELD_COMPANY=
GETCOURSE_FIELD_MESSAGE=
GETCOURSE_FIELD_QUESTION=
GETCOURSE_FIELD_POST_TITLE=
GETCOURSE_FIELD_REQUEST_ID=

# Note: After starting Strapi:
# 1. Create an admin user at http://localhost:1337/admin
# 2. Go to Settings > API Tokens
# 3. Create a new token with read access to all content types
# 4. Copy the token here

# Strapi CMS configuration for command-based switching:
# - npm run dev / npm run dev:local -> STRAPI_LOCAL_*
# - npm run dev:prod               -> STRAPI_PROD_*
# Read token powers content fetches; write token is used by
# POST /api/diagnostic-submissions/intake and /api/hr-diagnostic-submissions/intake.
STRAPI_LOCAL_URL=http://localhost:1337
STRAPI_LOCAL_API_TOKEN=
STRAPI_LOCAL_WRITE_API_TOKEN=
STRAPI_PROD_URL=https://admin.ncfg.ru
STRAPI_PROD_API_TOKEN=
STRAPI_PROD_WRITE_API_TOKEN=

# Optional legacy/default pair (used when STRAPI_SOURCE=default).
# In production, STRAPI_API_TOKEN and STRAPI_WRITE_API_TOKEN are sourced from Yandex Lockbox.
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token-here
STRAPI_WRITE_API_TOKEN=

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: absolute URL for portfolio presentation PDF in Object Storage
PORTFOLIO_PRESENTATION_URL=

# Optional: local Yandex Metrika counter ID for parity with production.
# Production resolves NEXT_PUBLIC_YANDEX_METRIKA_ID from Yandex Lockbox.
NEXT_PUBLIC_YANDEX_METRIKA_ID=108387180

# Postbox integration (email-first)
POSTBOX_SMTP_HOST=postbox.cloud.yandex.net
POSTBOX_SMTP_PORT=465
POSTBOX_API_KEY_ID=
POSTBOX_API_KEY_SECRET=
POSTBOX_FROM_EMAIL=no-reply@ncfg.ru
LEADS_RECIPIENT_EMAILS=aedengina@ncfg.ru,yura.posledov@yandex.ru,Zvs@ncfg.ru

# Legacy fallback recipient (used when LEADS_RECIPIENT_EMAILS is not set)
LEADS_RECIPIENT_EMAIL=

# Optional Bitrix24 lead fan-out for the primary website lead form.
# When BITRIX24_WEBHOOK_URL is set, /api/lead is still delivered through the
# primary sink above and is also synced to Bitrix24 as a CRM lead.
BITRIX24_WEBHOOK_URL=
BITRIX24_LEAD_ENABLED=true
BITRIX24_LEAD_SOURCE_ID=WEB
BITRIX24_LEAD_STAGE_ID=10
BITRIX24_LEAD_TITLE=Заявка с сайта NCFG
BITRIX24_LEAD_ORIGINATOR_ID=ncfg-website
BITRIX24_LEAD_ASSIGNED_BY_ID=

# GetCourse integration
GETCOURSE_BASE_URL=https://fgrm.ncfg.ru
GETCOURSE_API_KEY=
GETCOURSE_SOURCE_VALUE=fgrm.ncfg.ru
GETCOURSE_DEAL_PRODUCT_TITLE_LEAD=Website Lead
GETCOURSE_DEAL_PRODUCT_TITLE_QUESTION=Website Question
GETCOURSE_DEAL_PRODUCT_TITLE_VACANCY_APPLICATION=Website Vacancy Application
GETCOURSE_DEAL_COST=0
GETCOURSE_DEAL_STATUS=new

# Optional: extra deal fields in GetCourse (must already exist in account)
GETCOURSE_DEAL_FIELD_SOURCE=
GETCOURSE_DEAL_FIELD_COMPANY=
GETCOURSE_DEAL_FIELD_MESSAGE=
GETCOURSE_DEAL_FIELD_QUESTION=
GETCOURSE_DEAL_FIELD_POST_TITLE=
GETCOURSE_DEAL_FIELD_PAGE_URL=
GETCOURSE_DEAL_FIELD_REQUEST_ID=
GETCOURSE_DEAL_FIELD_FORM_TYPE=

  "sections": {
    "Hero": {
      "data": {
        "headline": "Успешно реализуем проекты по финансовой грамотности",
        "lead": "Помогаем клиентам разбираться в личных финансах - от детских программ до федеральных инициатив",
        "primaryCta": {
          "label": "Подробнее",
          "href": "#services"
        },
        "supportingHeadings": [
          "Почему мы № 1 в реализации проектов и сервисов по финансовой грамотности?",
          "Чем мы можем быть полезны?"
        ],
        "proofPoints": [
          {
            "strong": true,
            "text": "30 000 000 россиян приняли участие в мероприятиях, организованных НЦФГ по всей России",
            "links": [
              {
                "label": "Узнать больше о наших проектах",
                "href": "/portfolio"
              }
            ]
          },
          {
            "strong": true,
            "text": "Программы показывают стабильно высокие результаты (пример: 90 % считают полезной, 85 % — простой и понятной; улучшение тестирования в 2 раза; 9 из 10 готовы рекомендовать)",
            "links": [
              {
                "label": "Подробнее",
                "href": "/rekomendacii"
              }
            ]
          },
          {
            "strong": true,
            "text": "Клиенты рекомендуют: Минфин России, Сбербанк, «Почта Банк», «Мир», Финансовый университет РФ и др.; доверяют заботу о финансовом здоровье сотрудников более 2000 работодателей",
            "links": [
              {
                "label": "Подробнее",
                "href": "/klienty-partnery"
              }
            ]
          },
          {
            "strong": true,
            "text": "О нас регулярно говорят СМИ; более 3 000 публикаций",
            "links": [
              {
                "label": "Архив публикаций",
                "href": "/blog"
              }
            ]
          }
        ]
      }
    },

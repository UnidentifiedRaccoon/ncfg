# Strapi Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-api-token-here

# Optional: object storage bucket name (used by media checks)
AWS_BUCKET=

# Path to directory with source news images for re-upload (optional, needed for image migration)
NEWS_IMAGES_PATH=

# Path to photos directory + manifest for upload-person-photos.mjs (optional)
PEOPLE_PHOTOS_DIR=
PEOPLE_PHOTOS_MANIFEST_PATH=

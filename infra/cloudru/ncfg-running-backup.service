[Unit]
Description=NCFG database and media encrypted off-site backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/ncfg

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/ncfg/migration/backup-running-stack.py
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/ncfg

